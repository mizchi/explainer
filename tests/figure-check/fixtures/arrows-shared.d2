# 矢印が長く重なって走る図：TALA の既定の seed では、ブラウザからの 2 本が 1 本に見える
direction: down
*.style.font-size: 22
*.*.style.font-size: 22
browser: ブラウザ
mobile: アプリ
edge: エッジ {
  cdn: CDN
  gw: API Gateway
}
svc: サービス {
  auth: 認証
  order: 注文
  pay: 決済
}
data: データ {
  pg: Postgres {shape: cylinder}
  redis: Redis {shape: cylinder}
  mq: キュー {shape: queue}
}
browser -> edge.cdn
browser -> edge.gw
mobile -> edge.gw
edge.gw -> svc.auth
edge.gw -> svc.order
svc.order -> svc.pay
svc.order -> data.pg
svc.auth -> data.redis
svc.pay -> data.mq
svc.pay -> data.pg
