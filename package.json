{
  "name": "explainer",
  "private": true,
  "type": "module",
  "description": "Persona-calibrated crash-course explainers, with figures and claims checked by tools (vlmkit, vlmkit-anim).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:tla": "sh scripts/setup-tla.sh",
    "verify": "node skills/explainer/scripts/verify-doc.mjs docs/formal-methods",
    "build": "node skills/explainer/scripts/build-html.mjs docs/formal-methods/README.md",
    "verify:book": "node skills/explainer-book/scripts/verify-book.mjs docs/inductive-invariant-book",
    "build:book": "node skills/explainer/scripts/build-html.mjs docs/inductive-invariant-book/README.md docs/inductive-invariant-book/01-quickstart.md docs/inductive-invariant-book/02-reading-cti.md docs/inductive-invariant-book/03-strengthening.md",
    "verify:cheatsheet": "node skills/explainer/scripts/verify-doc.mjs docs/figure-cheatsheet",
    "build:cheatsheet": "node skills/explainer/scripts/build-html.mjs docs/figure-cheatsheet/README.md",
    "setup:d2": "sh scripts/setup-d2.sh",
    "test:figures": "node tests/figure-check/run.mjs",
    "figure": "node skills/explainer/scripts/figure-check.mjs",
    "figure:variants": "node skills/explainer/scripts/figure-variants.mjs",
    "readme:images": "node scripts/readme-images.mjs"
  },
  "devDependencies": {
    "@informalsystems/quint": "^0.32.0",
    "@mizchi/vlmkit": "^0.22.0",
    "@mizchi/vlmkit-anim": "^0.22.0",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "playwright": "1.56.1",
    "z3-solver": "^5.2.0"
  },
  "license": "MIT"
}
